# ==============================================================================
# Orchestrate Root Environment Configuration Template
# Copy this file to .env and provide your local credentials.
# NEVER commit .env to version control or expose API keys.
# ==============================================================================

# --- Node Environment ---
NODE_ENV=development

# --- Orchestrate Engine Server & Security ---
ORCHESTRATE_HOST=127.0.0.1
ORCHESTRATE_PORT=3001
ORCHESTRATE_DB_PATH=./orchestrate.sqlite
ORCHESTRATE_CORS_ORIGIN=http://localhost:3000
# Signing secret for JWT bearer tokens (Required in production: minimum 32 characters)
ORCHESTRATE_JWT_SECRET=

# --- Nebius Token Factory (Inference Provider) ---
# Required for live agent execution (evaluation runs are now frozen)
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_DEFAULT_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B

# --- Web Frontend ---
VITE_ENGINE_URL=http://127.0.0.1:3001
